{
  "name": "wavesco-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @wavesco/db db:migrate",
    "db:seed": "pnpm --filter @wavesco/db db:seed",
    "db:studio": "pnpm --filter @wavesco/db db:studio",
    "db:generate": "pnpm --filter @wavesco/db db:generate",
    "verify:contracts": "node scripts/verify-contracts.mjs",
    "generate:secrets": "node scripts/generate-secrets.mjs",
    "create-tenant": "tsx scripts/create-tenant.ts",
    "enable-module": "tsx scripts/enable-module.ts"
  },
  "devDependencies": {
    "@wavesco/auth": "workspace:*",
    "@wavesco/db": "workspace:*",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
