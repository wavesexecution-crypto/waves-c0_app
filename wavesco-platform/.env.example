# ============================================================
# WavesCo Platform — Environment Configuration (TEMPLATE)
# ============================================================
# Copy this file to .env and fill in values for local dev.
#
#   1) cp .env.example .env
#   2) pnpm generate:secrets   (fills AUTH_SECRET / NEXTAUTH_SECRET / JWT_SECRET)
#   3) docker compose up -d    (PostgreSQL 16 on :5433)
# ============================================================

# --- Application ---
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="WavesCo"
NEXTAUTH_URL="http://localhost:3000"

# --- Auth Secrets (REQUIRED, >= 32 chars) ---
# Auth.js v5 reads AUTH_SECRET; NextAuth v4's legacy alias is NEXTAUTH_SECRET.
# middleware.ts and auth.config.ts read `AUTH_SECRET ?? NEXTAUTH_SECRET`, so setting
# BOTH to the same value keeps everything consistent. Generate one manually with:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# or run `pnpm generate:secrets` to fill them automatically. JWT_SECRET signs the
# platform access/refresh tokens (jose HS256).
AUTH_SECRET=""
NEXTAUTH_SECRET=""
JWT_SECRET=""

# --- Token TTLs ---
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="30d"

# --- Database (REQUIRED) ---
# Start with: docker compose up -d  (or use Neon)
# url      = runtime role (wavesco_app, RLS enforced). When pointed at a
#            transaction-mode pooler (Neon pooler / PgBouncer) keep
#            pgbouncer=true so Prisma disables prepared statements.
# directUrl = migration role (wavesco, owns tables, bypasses RLS)
DATABASE_URL="postgresql://wavesco_app:wavesco_app@localhost:5433/wavesco?schema=public&pgbouncer=true"
DIRECT_URL="postgresql://wavesco:wavesco@localhost:5433/wavesco?schema=public"

# --- Email (Resend) — REQUIRED for magic-link signup + password reset ---
# Get a key at https://resend.com.
RESEND_API_KEY=""
SMTP_FROM="WavesCo <noreply@wavesco.dev>"
# Optional SMTP fallback used by the Nodemailer provider when Resend is unavailable:
SMTP_HOST="localhost"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# --- WavesCo Integrations (all server-side; never exposed to the browser) ---
# n8n: base URL enables health/webhook surfaces. REST API key unlocks
# workflow/execution reads for Automation OS. Create the key in n8n
# (Settings → n8n API → Create API key).
N8N_BASE_URL=""
N8N_API_KEY=""
# Lead Engine — dual mode:
#   local  (default): reads SQLite at LEAD_ENGINE_ROOT/data/leads.db and spawns CLI
#   remote (production): calls authenticated HTTP API at LEAD_ENGINE_API_URL
LEAD_ENGINE_MODE="local"
LEAD_ENGINE_ROOT="D:\\wavesco-lead-engine"
LEAD_ENGINE_API_URL=""
LEAD_ENGINE_API_TOKEN=""
# Optional: .env of another workspace copy holding shared credentials
# (e.g. Telegram bot token used by the Notify Hub bridge).
WAVESCO_ENV_PATH=""
# Intelligence — any OpenAI-compatible endpoint. Example: Ollama Cloud
# (OPENAI_BASE_URL="https://ollama.com/v1", OPENAI_MODEL="gemma4:31b").
# Leave OPENAI_API_KEY empty to disable AI features loudly.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
# Obsidian Local REST API (persistent human knowledge layer). The key is
# generated by the "Local REST API" community plugin in Obsidian.
OBSIDIAN_REST_URL="https://127.0.0.1:27124"
OBSIDIAN_API_KEY=""

# --- Waves AI Gateway (internal callers, e.g. Lead Engine) ---
# Token shared with trusted local engines; engine reads the same values.
LEAD_ENGINE_GATEWAY_TOKEN=""
WAVESCO_ENGINE_TENANT=""

# --- Platform ---
# Set to "true" to surface real billing (Stripe) features.
ENABLE_BILLING="false"